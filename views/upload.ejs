<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Voom — Video messaging</title>
<style>
*{margin:0;padding:0;box-sizing:border-box}
body{font-family:-apple-system,system-ui,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif;background:#0b0b0e;color:#e8e8ed;min-height:100vh}
.hdr{display:flex;align-items:center;justify-content:space-between;padding:1rem 1.5rem;border-bottom:1px solid #1e1e24}
.logo{font-size:1.4rem;font-weight:800;text-decoration:none;color:#e8e8ed}
.logo span{color:#625df5}
.nav{display:flex;gap:1rem}
.nav a{color:#888;text-decoration:none;font-size:0.85rem}
.nav a:hover{color:#625df5}
.main{max-width:900px;margin:2rem auto;padding:0 1.5rem}
.hero{text-align:center;margin-bottom:2.5rem}
.hero h1{font-size:2.2rem;font-weight:700;margin-bottom:0.5rem;background:linear-gradient(135deg,#e8e8ed,#888);-webkit-background-clip:text;-webkit-text-fill-color:transparent}
.hero p{color:#888;font-size:1rem}
.upload-zone{border:2px dashed #2a2a30;border-radius:16px;padding:3rem 2rem;text-align:center;cursor:pointer;transition:all .2s;background:#121216}
.upload-zone:hover{border-color:#625df5;background:#18181e}
.upload-zone.dragover{border-color:#625df5;background:#1a1a22}
.upload-icon{font-size:3rem;margin-bottom:0.75rem}
.upload-zone p{color:#aaa;font-size:0.9rem;margin-bottom:0.25rem}
.upload-zone .ext{color:#555;font-size:0.75rem}
.upload-form{margin-top:1.5rem;display:none}
.upload-form.visible{display:block}
.upload-form input[type="text"]{width:100%;padding:12px 16px;border-radius:10px;border:1px solid #2a2a30;background:#1a1a20;color:#e8e8ed;font-size:1rem;outline:none;margin-bottom:1rem}
.upload-form input[type="text"]:focus{border-color:#625df5}
.upload-form button{padding:12px 24px;border-radius:10px;border:none;background:#625df5;color:#fff;font-size:1rem;font-weight:600;cursor:pointer}
.upload-form button:hover{background:#5348e8}
.success-box{background:#1a2a1a;border:1px solid #2a5a2a;border-radius:12px;padding:1.5rem;margin-top:1.5rem;text-align:center;display:none}
.success-box.visible{display:block}
.success-box .link{color:#625df5;font-size:1rem;word-break:break-all;display:block;margin:0.75rem 0;padding:0.75rem;background:#1e1e26;border-radius:8px}
.success-box .hint{color:#888;font-size:0.8rem}
.file-info{font-size:0.85rem;color:#aaa;margin-top:0.5rem}
.recent{margin-top:3rem}
.recent h2{font-size:1.1rem;margin-bottom:1rem;color:#888}
.video-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(160px,1fr));gap:1rem}
.video-card{background:#121216;border:1px solid #1e1e24;border-radius:10px;overflow:hidden;text-decoration:none;color:#e8e8ed;transition:border-color .2s}
.video-card:hover{border-color:#625df5}
.video-card-thumb{background:#1a1a22;height:90px;display:flex;align-items:center;justify-content:center;font-size:2rem}
.video-card-body{padding:0.75rem}
.video-card-title{font-size:0.85rem;font-weight:600;margin-bottom:0.15rem;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.video-card-meta{font-size:0.7rem;color:#666}
</style>
</head>
<body>
<div class="hdr">
<a href="/" class="logo">V<span>oom</span></a>
<div class="nav">
<a href="/dashboard">Dashboard</a>
</div>
</div>

<div class="main">
<div class="hero">
<h1>Record, share, and track your videos</h1>
<p>Upload a video, get a shareable link, and get notified every time someone watches.</p>
</div>

<div class="upload-zone" id="dropZone">
<div class="upload-icon">🎥</div>
<p>Click to upload or drag a video here</p>
<p class="ext">MP4, WebM, MOV, AVI, MKV — up to 1GB</p>
<div id="fileInfo" class="file-info"></div>
</div>
<input type="file" id="fileInput" accept="video/*" style="display:none">

<div class="upload-form" id="uploadForm">
<input type="text" id="titleInput" placeholder="Video title (e.g., Proposal for Smith Roofing)">
<button id="submitBtn" onclick="uploadVideo()">Upload Video</button>
<div id="progress" style="margin-top:0.5rem;font-size:0.85rem;color:#888"></div>
</div>

<div class="success-box" id="successBox">
<p style="color:#4ade80;font-weight:600;margin-bottom:0.5rem">✅ Uploaded!</p>
<p style="font-size:0.85rem;color:#aaa;margin-bottom:0.25rem">Share this link — you'll be notified every time it's watched:</p>
<div class="link" id="videoLink"></div>
<p class="hint">Copy this link and send it to anyone. No login required to watch.</p>
<a href="/" style="display:inline-block;margin-top:1rem;color:#625df5;text-decoration:none">Upload another &rarr;</a>
</div>

<% if (videos.length > 0) { %>
<div class="recent">
<h2>Recent videos</h2>
<div class="video-grid">
<% videos.forEach(v => { %>
<a href="/watch/<%= v.id %>" class="video-card">
<div class="video-card-thumb">🎬</div>
<div class="video-card-body">
<div class="video-card-title"><%= v.title %></div>
<div class="video-card-meta"><%= v.total_views %> view<%= v.total_views !== 1 ? 's' : '' %> · <%= new Date(v.created_at).toLocaleDateString() %></div>
</div>
</a>
<% }) %>
</div>
</div>
<% } %>
</div>

<script>
const dropZone = document.getElementById('dropZone');
const fileInput = document.getElementById('fileInput');
const fileInfo = document.getElementById('fileInfo');
const uploadForm = document.getElementById('uploadForm');
const titleInput = document.getElementById('titleInput');
const progress = document.getElementById('progress');
const successBox = document.getElementById('successBox');
const videoLink = document.getElementById('videoLink');
let selectedFile = null;

dropZone.addEventListener('click', () => fileInput.click());
dropZone.addEventListener('dragover', (e) => { e.preventDefault(); dropZone.classList.add('dragover'); });
dropZone.addEventListener('dragleave', () => dropZone.classList.remove('dragover'));
dropZone.addEventListener('drop', (e) => {
  e.preventDefault(); dropZone.classList.remove('dragover');
  if (e.dataTransfer.files.length) { fileInput.files = e.dataTransfer.files; handleFile(e.dataTransfer.files[0]); }
});
fileInput.addEventListener('change', () => { if (fileInput.files.length) handleFile(fileInput.files[0]); });

function handleFile(file) {
  selectedFile = file;
  const size = file.size > 1024*1024 ? (file.size/1024/1024).toFixed(1)+'MB' : (file.size/1024).toFixed(1)+'KB';
  fileInfo.innerHTML = `Selected: <strong>${file.name}</strong> (${size})`;
  titleInput.value = file.name.replace(/\.[^.]+$/, '');
  uploadForm.classList.add('visible');
}

function uploadVideo() {
  if (!selectedFile) return;
  const form = new FormData();
  form.append('video', selectedFile);
  form.append('title', titleInput.value || selectedFile.name);
  submitBtn.disabled = true;
  submitBtn.textContent = 'Uploading...';
  progress.textContent = 'Uploading...';

  fetch('/upload', { method: 'POST', body: form })
    .then(r => r.json())
    .then(data => {
      if (data.link) {
        successBox.classList.add('visible');
        videoLink.textContent = data.link;
        videoLink.onclick = () => { navigator.clipboard.writeText(data.link); videoLink.textContent = 'Copied!'; setTimeout(() => videoLink.textContent = data.link, 2000); };
        uploadForm.classList.remove('visible');
        dropZone.style.display = 'none';
        progress.textContent = '';
      }
    })
    .catch(e => { progress.textContent = 'Error: ' + e.message; submitBtn.disabled = false; submitBtn.textContent = 'Upload Video'; });
}
</script>
</body>
</html>